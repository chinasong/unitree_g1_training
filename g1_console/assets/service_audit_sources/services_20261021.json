      "format": "text",
      "loaded_by_active_motor_controller_verified": false,
      "text": "#! /bin/sh\n\n### BEGIN INIT INFO\n# Provides:          master_service\n# Required-Start:    $local_fs $network $named\n# Required-Stop:     $remote_fs\n# Default-Start:     2 3 4 5\n# Default-Stop:      0 1 6\n# Short-Description: master service init script.\n# Description:       master service init script. start master service use start-stop-daemon.\n### END INIT INFO\n\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\nDAEMON=/unitree/module/master_service/master_service\nNAME=master_service\nDESC=master_service\n\ntest -x $DAEMON || exit 0\n\n. /lib/init/vars.sh                                                                                                                                                                                                                       \n. /lib/lsb/init-functions\n\nPIDFILE=/unitree/var/run/master_service.pid\nSTOPDELAY=1\n\nSTARTDELAY=0.5\n\nrunning_pid()\n{\n    # Check if a given process pid's cmdline matches a given name\n    pid=$1\n    name=$2\n    [ -z \"$pid\" ] && return 1\n    [ ! -d /proc/$pid ] &&  return 1\n    cmd=`cat /proc/$pid/cmdline | tr \"\\000\" \"\\n\"|head -n 1 |cut -d : -f 1`\n    # Is this the expected child?\n    [ \"$cmd\" != \"$name\" ] &&  return 1\n    return 0\n}\n\nrunning()\n{\n# Check if the process is running looking at /proc\n# (works for all users)\n\n    # No pidfile, probably no daemon present\n    [ ! -f \"$PIDFILE\" ] && return 1\n    # Obtain the pid and check it against the binary name\n    pid=`cat $PIDFILE`\n    running_pid $pid $DAEMON || return 1\n    return 0\n}\n\ndo_force_stop() {\n# Forcefully kill the process\n    [ ! -f \"$PIDFILE\" ] && return\n    if running ; then\n        kill -2 $pid\n        sleep $STOPDELAY\n        if running ; then\n            kill -9 $pid\n\t    sleep $STOPDELAY\n            if running ; then\n                echo \"Cannot kill $NAME (pid=$pid)!\"\n                exit 1\n            fi\n        fi\n    fi\n    rm -f $PIDFILE\n    return 0\n}\ndo_start() {\n        # Check if we have the configuration file\n        ulimit -c 0\n        start-stop-daemon --start --background --no-close --make-pidfile --pidfile $PIDFILE --exec $DAEMON\n}\ndo_stop() {\n        start-stop-daemon --stop --pidfile $PIDFILE --exec $DAEMON\n}\n\ncase \"$1\" in\n  start)\n        echo -n \"Starting $DESC: \"\n        do_start\n\tsleep $STARTDELAY\n\n        if running ; then\n            echo \"$NAME.\"\n        else\n            echo \" ERROR.\"\n        fi\n        ;;\n  stop)\n        echo -n \"Stopping $DESC: \"\n        do_stop\n        echo \"$NAME.\"\n        ;;\n  force-stop)\n        echo -n \"Forcefully stopping $DESC: \"\n        do_force_stop\n        if ! running ; then\n            echo \"$NAME.\"\n        else\n            echo \" ERROR.\"\n        fi\n        ;;\n  restart|reload|force-reload)\n    echo -n \"Restarting $DESC: \"\n        do_stop\n        sleep $STOPDELAY\n        do_start\n        echo \"$NAME.\"\n        ;;\n\n  status)\n    echo -n \"$NAME is \"\n    if running ;  then\n        echo \"running\"\n    else\n        echo \" not running.\"\n        exit 1\n    fi\n    ;;\n  *)\n    N=/etc/init.d/$NAME\n    # echo \"Usage: $N {start|stop|restart|reload|force-reload}\" >&2\n    echo \"Usage: $N {start|stop|restart|force-reload|status|force-stop}\" >&2\n    exit 1\n    ;;\nesac\n\nexit 0"
