      "path": "/unitree/var/data/chrony/chrony_setup.sh",
      "bytes": 1629,
      "sha256": "543c6382d464d6d2d1b99a3c5ebbdb2fb72701bf8f80a4dc30acf885b99620f7",
      "format": "text",
      "loaded_by_active_motor_controller_verified": false,
      "text": "#!/bin/bash\nCHRONY_DEB=/unitree/var/data/chrony/chrony_3.5-6ubuntu6.2_arm64.deb\n\necho \"=== Permanently disable systemd-timesyncd ===\"\necho \"\"\n# 1. 停止服务\nsudo systemctl stop systemd-timesyncd\nif [ $? -ne 0 ]; then\n    exit 1\nfi\n# 2. 禁用启动\nsudo systemctl disable systemd-timesyncd\nif [ $? -ne 0 ]; then\n    exit 1\nfi\n# 3. 屏蔽服务（防止被其他服务启动）\nsudo systemctl mask systemd-timesyncd\nif [ $? -ne 0 ]; then\n    exit 1\nfi\n# 4. 重新加载 systemd\nsudo systemctl daemon-reload\nif [ $? -ne 0 ]; then\n    exit 1\nelse\n    echo \"Confirmed: systemd-timesyncd is completely disabled\"\nfi\n\n# 5. 安装 chrony\nif sudo dpkg -i --force-conflicts \"$CHRONY_DEB\"; then\n\n    echo \"Chrony install success\"\n    echo \"Start config chrony\"\n    # 启动并启用 chrony 服务\n    sudo systemctl start chrony\n    if [ $? -ne 0 ]; then\n        echo \"start chrony failed\"\n        exit 1\n    fi\n    sudo systemctl enable chrony\n    if [ $? -ne 0 ]; then\n        echo \"enable chrony failed\"\n        exit 1\n    fi\n\n    #替换配置文件\n    sudo mv /etc/chrony/chrony.config /etc/chrony/chrony.conf\n    if [ $? -ne 0 ]; then\n        echo \"Replace the chrony.conf file failed\"\n        exit 1\n    fi\n\n    sudo mv /etc/chrony/chrony.service /lib/systemd/system/chrony.service\n    if [ $? -ne 0 ]; then\n        echo \"Replace the chrony.service file failed\"\n        exit 1\n    fi\n\n    # 重启 chrony 服务\n    sudo systemctl restart chrony\n    if [ $? -ne 0 ]; then\n        echo \"restart chrony failed\"\n        exit 1\n    fi\n\n    echo \"Chrony installed and configured successfully\"\nelse\n    echo \"Chrony install failed\"\nfi"
    },
